{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orca-Tauri",
  "identifier": "dev.orca-tauri.desktop",
  "build": {
    "frontendDist": "../assets"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": ["shell-deny-web-ipc"],
      "csp": "default-src 'none'; style-src 'self'; img-src 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "On-demand desktop shell for the Orca runtime",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.icns"],
    "windows": {
      "webviewInstallMode": {"type": "downloadBootstrapper"},
      "nsis": {"installMode": "currentUser"}
    }
  }
}
